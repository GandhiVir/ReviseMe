# Provisioned automatically by `netlify db init` (Netlify DB / Neon Postgres) —
# for local dev, run `netlify dev` (which injects it) or copy the value from
# `netlify env:get NETLIFY_DATABASE_URL` into this file as NETLIFY_DATABASE_URL.
NETLIFY_DATABASE_URL=

# Same keys used by the mobile app's Worker — server-side only here, since
# Next.js API routes never ship these to the client.
GEMINI_API_KEY=
GROQ_API_KEY=
