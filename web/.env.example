# A free Neon Postgres project (neon.tech) — not Netlify's own managed
# database product, which requires a paid plan. Copy the connection string
# from your Neon project dashboard.
DATABASE_URL=

# Same keys used by the mobile app's Worker — server-side only here, since
# Next.js API routes never ship these to the client.
GEMINI_API_KEY=
GROQ_API_KEY=

# Google OAuth login (Auth.js / NextAuth v5). Create credentials at
# https://console.cloud.google.com/apis/credentials — OAuth client ID,
# type "Web application", authorized redirect URI:
#   http://localhost:8888/api/auth/callback/google       (local dev via `netlify dev`)
#   https://<your-site>.netlify.app/api/auth/callback/google   (production)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Random secret NextAuth uses to sign session tokens — generate with:
#   openssl rand -base64 33
AUTH_SECRET=
